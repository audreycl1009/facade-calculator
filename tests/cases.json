{
  "tolerance_percent": 1,
  "note": "Expected values are Audrey's hand calculations in test-cases.md. Vent is entered as Louver and Entrance as Door, because v1 only has those three opening types.",
  "cases": [
    {
      "name": "Case 1: simplest facade",
      "input": {
        "minDeduct": 0,
        "waste": { "Concrete": 5 },
        "facades": [{ "name": "C1", "width": 10, "height": 6, "qty": 1,
          "zones": [{ "material": "Concrete", "bottom": 0, "top": 6 }],
          "openings": [{ "type": "Window", "width": 1.5, "height": 1.2, "sill": 0.9, "count": 4 }] }]
      },
      "expected": { "Concrete": { "net": 52.80, "order": 55.44 } }
    },
    {
      "name": "Case 2: several opening types, quantity 2",
      "input": {
        "minDeduct": 0,
        "waste": { "Brick": 8 },
        "facades": [{ "name": "C2", "width": 12, "height": 8, "qty": 2,
          "zones": [{ "material": "Brick", "bottom": 0, "top": 8 }],
          "openings": [
            { "type": "Window", "width": 1.8, "height": 1.5, "sill": 1.0, "count": 3 },
            { "type": "Door", "width": 1.0, "height": 2.1, "sill": 0, "count": 1 }
          ] }]
      },
      "expected": { "Brick": { "net": 171.60, "order": 185.33 } }
    },
    {
      "name": "Case 3: two zones, openings stay inside one zone",
      "input": {
        "minDeduct": 0,
        "waste": { "Stone": 10, "Paint": 3 },
        "facades": [{ "name": "C3", "width": 10, "height": 9, "qty": 1,
          "zones": [
            { "material": "Stone", "bottom": 0, "top": 3 },
            { "material": "Paint", "bottom": 3, "top": 9 }
          ],
          "openings": [
            { "type": "Door", "width": 2.0, "height": 2.4, "sill": 0, "count": 1 },
            { "type": "Window", "width": 1.5, "height": 1.5, "sill": 4.0, "count": 4 }
          ] }]
      },
      "expected": { "Stone": { "net": 25.20, "order": 27.72 }, "Paint": { "net": 51.00, "order": 52.53 } }
    },
    {
      "name": "Case 4: threshold skips small openings",
      "input": {
        "minDeduct": 0.5,
        "waste": { "Panel": 5 },
        "facades": [{ "name": "C4", "width": 15, "height": 6, "qty": 1,
          "zones": [{ "material": "Panel", "bottom": 0, "top": 6 }],
          "openings": [
            { "type": "Window", "width": 2.0, "height": 1.5, "sill": 1.0, "count": 3 },
            { "type": "Louver", "width": 0.6, "height": 0.6, "sill": 4.5, "count": 4 },
            { "type": "Door", "width": 1.2, "height": 2.2, "sill": 0, "count": 1 }
          ] }]
      },
      "expected": { "Panel": { "net": 78.36, "order": 82.28 } },
      "expected_not_deducted": { "Louver": 4 }
    },
    {
      "name": "Case 5: three zones, openings across zones, threshold, quantity 2",
      "input": {
        "minDeduct": 0.5,
        "waste": { "Stone": 10, "Tile": 7, "Metal": 5 },
        "facades": [{ "name": "C5", "width": 20, "height": 12, "qty": 2,
          "zones": [
            { "material": "Stone", "bottom": 0, "top": 4 },
            { "material": "Tile", "bottom": 4, "top": 10 },
            { "material": "Metal", "bottom": 10, "top": 12 }
          ],
          "openings": [
            { "type": "Door", "width": 3.0, "height": 3.0, "sill": 0, "count": 1 },
            { "type": "Window", "width": 2.0, "height": 2.0, "sill": 3.0, "count": 5 },
            { "type": "Window", "width": 2.0, "height": 1.5, "sill": 7.0, "count": 5 },
            { "type": "Louver", "width": 1.0, "height": 2.5, "sill": 9.0, "count": 2 },
            { "type": "Louver", "width": 0.4, "height": 0.4, "sill": 11.0, "count": 6 }
          ] }]
      },
      "expected": {
        "Stone": { "net": 122.00, "order": 134.20 },
        "Tile": { "net": 186.00, "order": 199.02 },
        "Metal": { "net": 74.00, "order": 77.70 }
      },
      "expected_not_deducted": { "Louver": 12 }
    }
  ]
}
